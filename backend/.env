# ─────────────────────────────────────────────────
#  DocMind — Environment Variables
# ─────────────────────────────────────────────────

# 🔀  Active LLM Provider — change this to switch models
#  Options: groq | openai | gemini
MODEL_PROVIDER=openai

# 🧠  GROQ — Free tier (Llama 3.3 70B)
#  Sign up → https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# 🤖  OPENAI — GPT-4o-mini etc.
#  Sign up → https://platform.openai.com
OPENAI_API_KEY=sk_27393d634dacb0951643ec2d99848947367540fca6d64204

# 🌟  GEMINI — Google AI Studio (free tier available)
#  Sign up → https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
